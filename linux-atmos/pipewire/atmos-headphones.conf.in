# Atmos Headphones: 7.1.4 -> binaural virtual sink for PipeWire.
#
# This is the Linux counterpart of DolbyHrtfEnc.dll ("Dolby Atmos for Headphones") from
# Dolby Access: it takes a 7.1.4 speaker feed and renders each speaker through a head-related
# transfer function (HRTF), so headphones sound like a 7.1.4 room. Unlike Dolby's renderer it
# uses an open SOFA HRTF set, which you can swap for one that fits your ears better.
#
# Installed by install.sh, which substitutes the SOFA file path. Manual install:
#   cp atmos-headphones.conf ~/.config/pipewire/pipewire.conf.d/   (then restart pipewire)
#
# Speaker angles follow the Dolby 7.1.4 reference layout and match what atmos-decode renders:
# fronts +-30, sides +-90, rears +-135, top fronts +-45 / 45 up, top rears +-135 / 45 up.
#
# @generated by tools/gen-pipewire-conf.py - edit that script instead of this file.

context.modules = [
    { name = libpipewire-module-filter-chain
        flags = [ nofail ]
        args = {
            node.description = "Atmos Headphones (7.1.4 binaural)"
            media.name       = "Atmos Headphones (7.1.4 binaural)"
            filter.graph = {
                nodes = [
                    # front left
                    {
                        type = sofa
                        label = spatializer
                        name = spFL
                        config = {
                            filename = "@SOFA_FILE@"
                            # The right gain depends on the .sofa file in use
                            gain = @HRTF_GAIN@
                        }
                        control = {
                            "Azimuth"   = 30.0
                            "Elevation" = 0.0
                            # Keep Radius last and != 1.0: PipeWire <= 1.0.x only loads the HRTF
                            # if the last control set differs from its default.
                            "Radius"    = @HRTF_RADIUS@
                        }
                    }
                    # front right
                    {
                        type = sofa
                        label = spatializer
                        name = spFR
                        config = {
                            filename = "@SOFA_FILE@"
                            # The right gain depends on the .sofa file in use
                            gain = @HRTF_GAIN@
                        }
                        control = {
                            "Azimuth"   = 330.0
                            "Elevation" = 0.0
                            # Keep Radius last and != 1.0: PipeWire <= 1.0.x only loads the HRTF
                            # if the last control set differs from its default.
                            "Radius"    = @HRTF_RADIUS@
                        }
                    }
                    # center
                    {
                        type = sofa
                        label = spatializer
                        name = spFC
                        config = {
                            filename = "@SOFA_FILE@"
                            # The right gain depends on the .sofa file in use
                            gain = @HRTF_GAIN@
                        }
                        control = {
                            "Azimuth"   = 0.0
                            "Elevation" = 0.0
                            # Keep Radius last and != 1.0: PipeWire <= 1.0.x only loads the HRTF
                            # if the last control set differs from its default.
                            "Radius"    = @HRTF_RADIUS@
                        }
                    }
                    # rear surround left
                    {
                        type = sofa
                        label = spatializer
                        name = spRL
                        config = {
                            filename = "@SOFA_FILE@"
                            # The right gain depends on the .sofa file in use
                            gain = @HRTF_GAIN@
                        }
                        control = {
                            "Azimuth"   = 135.0
                            "Elevation" = 0.0
                            # Keep Radius last and != 1.0: PipeWire <= 1.0.x only loads the HRTF
                            # if the last control set differs from its default.
                            "Radius"    = @HRTF_RADIUS@
                        }
                    }
                    # rear surround right
                    {
                        type = sofa
                        label = spatializer
                        name = spRR
                        config = {
                            filename = "@SOFA_FILE@"
                            # The right gain depends on the .sofa file in use
                            gain = @HRTF_GAIN@
                        }
                        control = {
                            "Azimuth"   = 225.0
                            "Elevation" = 0.0
                            # Keep Radius last and != 1.0: PipeWire <= 1.0.x only loads the HRTF
                            # if the last control set differs from its default.
                            "Radius"    = @HRTF_RADIUS@
                        }
                    }
                    # side surround left
                    {
                        type = sofa
                        label = spatializer
                        name = spSL
                        config = {
                            filename = "@SOFA_FILE@"
                            # The right gain depends on the .sofa file in use
                            gain = @HRTF_GAIN@
                        }
                        control = {
                            "Azimuth"   = 90.0
                            "Elevation" = 0.0
                            # Keep Radius last and != 1.0: PipeWire <= 1.0.x only loads the HRTF
                            # if the last control set differs from its default.
                            "Radius"    = @HRTF_RADIUS@
                        }
                    }
                    # side surround right
                    {
                        type = sofa
                        label = spatializer
                        name = spSR
                        config = {
                            filename = "@SOFA_FILE@"
                            # The right gain depends on the .sofa file in use
                            gain = @HRTF_GAIN@
                        }
                        control = {
                            "Azimuth"   = 270.0
                            "Elevation" = 0.0
                            # Keep Radius last and != 1.0: PipeWire <= 1.0.x only loads the HRTF
                            # if the last control set differs from its default.
                            "Radius"    = @HRTF_RADIUS@
                        }
                    }
                    # top front left
                    {
                        type = sofa
                        label = spatializer
                        name = spTFL
                        config = {
                            filename = "@SOFA_FILE@"
                            # The right gain depends on the .sofa file in use
                            gain = @HRTF_GAIN@
                        }
                        control = {
                            "Azimuth"   = 45.0
                            "Elevation" = 45.0
                            # Keep Radius last and != 1.0: PipeWire <= 1.0.x only loads the HRTF
                            # if the last control set differs from its default.
                            "Radius"    = @HRTF_RADIUS@
                        }
                    }
                    # top front right
                    {
                        type = sofa
                        label = spatializer
                        name = spTFR
                        config = {
                            filename = "@SOFA_FILE@"
                            # The right gain depends on the .sofa file in use
                            gain = @HRTF_GAIN@
                        }
                        control = {
                            "Azimuth"   = 315.0
                            "Elevation" = 45.0
                            # Keep Radius last and != 1.0: PipeWire <= 1.0.x only loads the HRTF
                            # if the last control set differs from its default.
                            "Radius"    = @HRTF_RADIUS@
                        }
                    }
                    # top rear left
                    {
                        type = sofa
                        label = spatializer
                        name = spTRL
                        config = {
                            filename = "@SOFA_FILE@"
                            # The right gain depends on the .sofa file in use
                            gain = @HRTF_GAIN@
                        }
                        control = {
                            "Azimuth"   = 135.0
                            "Elevation" = 45.0
                            # Keep Radius last and != 1.0: PipeWire <= 1.0.x only loads the HRTF
                            # if the last control set differs from its default.
                            "Radius"    = @HRTF_RADIUS@
                        }
                    }
                    # top rear right
                    {
                        type = sofa
                        label = spatializer
                        name = spTRR
                        config = {
                            filename = "@SOFA_FILE@"
                            # The right gain depends on the .sofa file in use
                            gain = @HRTF_GAIN@
                        }
                        control = {
                            "Azimuth"   = 225.0
                            "Elevation" = 45.0
                            # Keep Radius last and != 1.0: PipeWire <= 1.0.x only loads the HRTF
                            # if the last control set differs from its default.
                            "Radius"    = @HRTF_RADIUS@
                        }
                    }
                    # LFE has no direction: feed it to both ears equally
                    { type = builtin label = copy name = lfe }

                    # Mixers take at most 8 inputs, so each ear sums in two stages
                    { type = builtin label = mixer name = mixL1 }
                    { type = builtin label = mixer name = mixR1 }
                    { type = builtin label = mixer name = mixL2
                        control = { "Gain 5" = @LFE_GAIN@ }
                    }
                    { type = builtin label = mixer name = mixR2
                        control = { "Gain 5" = @LFE_GAIN@ }
                    }
                ]
                links = [
                    { output = "spFL:Out L" input = "mixL1:In 1" }
                    { output = "spFL:Out R" input = "mixR1:In 1" }
                    { output = "spFR:Out L" input = "mixL1:In 2" }
                    { output = "spFR:Out R" input = "mixR1:In 2" }
                    { output = "spFC:Out L" input = "mixL1:In 3" }
                    { output = "spFC:Out R" input = "mixR1:In 3" }
                    { output = "spRL:Out L" input = "mixL1:In 4" }
                    { output = "spRL:Out R" input = "mixR1:In 4" }
                    { output = "spRR:Out L" input = "mixL1:In 5" }
                    { output = "spRR:Out R" input = "mixR1:In 5" }
                    { output = "spSL:Out L" input = "mixL1:In 6" }
                    { output = "spSL:Out R" input = "mixR1:In 6" }
                    { output = "spSR:Out L" input = "mixL1:In 7" }
                    { output = "spSR:Out R" input = "mixR1:In 7" }
                    { output = "spTFL:Out L" input = "mixL1:In 8" }
                    { output = "spTFL:Out R" input = "mixR1:In 8" }
                    { output = "mixL1:Out" input = "mixL2:In 1" }
                    { output = "mixR1:Out" input = "mixR2:In 1" }
                    { output = "spTFR:Out L" input = "mixL2:In 2" }
                    { output = "spTFR:Out R" input = "mixR2:In 2" }
                    { output = "spTRL:Out L" input = "mixL2:In 3" }
                    { output = "spTRL:Out R" input = "mixR2:In 3" }
                    { output = "spTRR:Out L" input = "mixL2:In 4" }
                    { output = "spTRR:Out R" input = "mixR2:In 4" }
                    { output = "lfe:Out" input = "mixL2:In 5" }
                    { output = "lfe:Out" input = "mixR2:In 5" }
                ]
                inputs  = [ "spFL:In" "spFR:In" "spFC:In" "lfe:In" "spRL:In" "spRR:In" "spSL:In" "spSR:In" "spTFL:In" "spTFR:In" "spTRL:In" "spTRR:In" ]
                outputs = [ "mixL2:Out" "mixR2:Out" ]
            }
            capture.props = {
                node.name      = "effect_input.atmos_headphones"
                media.class    = Audio/Sink
                audio.channels = 12
                audio.position = [ FL FR FC LFE RL RR SL SR TFL TFR TRL TRR ]
            }
            playback.props = {
                node.name      = "effect_output.atmos_headphones"
                node.passive   = true
                audio.channels = 2
                audio.position = [ FL FR ]
            }
        }
    }
]
